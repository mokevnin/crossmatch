.env
.env.*
/bin/
/tmp/
*.test
*.out
.DS_Store
.lycheecache

# Links that mise makes into .claude/skills for the skills the tools ship (`mise skills sync`); they point
# into the mise installs, so they are not shared. Add a tool's skills here when a new tool ships some.
/.claude/skills/fnox
/.claude/skills/hk-*
/.claude/skills/pitchfork
/.claude/skills/.mise-skills.json

# Git worktrees of this repository: `git worktree add .worktrees/<name>`, and Claude Code puts its own
# there too (the WorktreeCreate hook, .claude/hooks/worktree.sh).
/.worktrees/
# Where Claude Code made them before the hook; trees made then still live there.
/.claude/worktrees/
