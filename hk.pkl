amends "package://github.com/jdx/hk/releases/download/v2.11.0/hk@2.11.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.0/hk@2.11.0#/Builtins.pkl"

// A commit hook runs only what is fast on the staged files. Whole-project checks run on push, and
// `check` (and so CI) runs everything. A check that exists only in a hook is not enforced.
local fast = new Mapping<String, Step> {
    ["betterleaks"] {
        check = "betterleaks dir --redact --no-banner ."
        exclusive = true
    }
    ["golangci_lint"] = Builtins.golangci_lint
    ["rumdl"] = Builtins.rumdl
    ["typos"] = Builtins.typos
    ["hadolint"] {
        glob = List("Dockerfile*")
        check = "hadolint {{files}}"
    }
    ["lychee"] {
        glob = List("**/*.md", "lychee.toml")
        check = "lychee --config lychee.toml --offline --no-progress {{files}}"
    }
    ["sqruff"] {
        glob = List("**/*.sql")
        check = "sqruff lint {{files}}"
        fix = "sqruff fix {{files}}"
    }
    ["easement"] {
        glob = List("**/*.go", "easement.yml", "go.mod")
        check = "easement check"
        exclusive = true
    }
    ["squawk"] {
        glob = List("migrations/*.sql", ".squawk.toml")
        check = "squawk -c .squawk.toml migrations/*.sql"
    }
    // The Go code in internal/store is what sqlc writes from the migrations and queries.
    ["sqlc"] {
        glob = List("migrations/*.sql", "queries/*.sql", "sqlc.yaml")
        check = "sqlc diff"
        fix = "sqlc generate"
        exclusive = true
    }
}

// Slower checks, or ones that need the network: on push and in CI, not on every commit.
local all = (fast) {
    // The tree is scanned in the hook; the whole history is scanned here.
    ["betterleaks_history"] {
        check = "betterleaks git --redact --no-banner"
        exclusive = true
    }
    // Known vulnerabilities in the modules and standard library the code actually calls.
    ["govulncheck"] {
        glob = List("**/*.go", "go.mod", "go.sum")
        check = "govulncheck ./..."
        exclusive = true
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = fast
    }
    ["pre-push"] {
        steps = all
    }
    ["check"] {
        steps = all
    }
    ["fix"] {
        fix = true
        steps = all
    }
}
